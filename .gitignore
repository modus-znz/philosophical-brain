__pycache__/
*.pyc
.venv/

# graphify writes run artifacts (query caches, dated result dirs) beside the
# graph. Only the graph itself is a deliverable -- it stays tracked so a fresh
# clone can be queried without a build step.
graphify-out/*
!graphify-out/graph.json

# Opt-in destination for the generated persona library (render_persona.py).
# Untracked on purpose: a clone must not write into a stranger's ~/.claude.
.persona-target

# Default in-repo render target when .persona-target is absent.
persona/wisdom-quotes.generated.md

# Git worktrees (superpowers:using-git-worktrees creates them here). They hold
# a full second copy of the vault; lint_attributions.py is taught to skip every
# dot-directory so they cannot double the defect count.
.claude/
